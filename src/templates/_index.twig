{# =========================================================================
   Portfolios: the index
   Every portfolio the plugin manages, with drift called out above the table.
   ========================================================================= #}
{% extends '_layouts/cp' %}

{% set title = 'Portfolios'|t('portfolio') %}
{% set selectedSubnavItem = 'portfolios' %}

{# Building and adopting write project config, which the controller gates on admin + allowAdminChanges. #}
{% set canChangeSchema = currentUser.admin
    and craft.app.config.general.allowAdminChanges
    and currentUser.can('portfolio:managePortfolios') %}

{% block actionButton %}
    {% if canChangeSchema and canAdopt %}
        <a href="{{ cpUrl('portfolio/adopt') }}" class="btn">{{ 'Adopt a section'|t('portfolio') }}</a>
    {% endif %}
    {% if canChangeSchema and canAdd %}
        <a href="{{ cpUrl('portfolio/new') }}" class="btn submit add icon">{{ 'Build a portfolio'|t('portfolio') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    {% if portfolios is empty %}
        <div class="zilch">
            <p>{{ 'No portfolios yet.'|t('portfolio') }}</p>
            <p>{{ 'A portfolio is a section, an entry type, a set of fields and a taxonomy, built in one go and remembered by role, so your templates never name a field handle.'|t('portfolio') }}</p>
        </div>
    {% else %}
        {% if not canAdd %}
            <div class="readable">
                <blockquote class="note">
                    <p>{{ limitMessage }}</p>
                </blockquote>
            </div>
            <hr>
        {% endif %}

        {% if drift is not empty %}
            <div class="readable">
                <blockquote class="note warning">
                    <p><strong>{{ 'Needs attention'|t('portfolio') }}</strong></p>
                    {% for portfolio in portfolios %}
                        {% if drift[portfolio.uid] is defined %}
                            <p>
                                <a href="{{ cpUrl('portfolio/' ~ portfolio.uid) }}">{{ portfolio.name }}</a>
                            </p>
                            <ul class="bullets">
                                {% for problem in drift[portfolio.uid] %}<li>{{ problem }}</li>{% endfor %}
                            </ul>
                        {% endif %}
                    {% endfor %}
                </blockquote>
            </div>
            <hr>
        {% endif %}

        <div class="tableview">
            <table class="data fullwidth collapsible">
                <thead>
                    <tr>
                        <th scope="col">{{ 'Name'|t('portfolio') }}</th>
                        <th scope="col">{{ 'Handle'|t('portfolio') }}</th>
                        <th scope="col">{{ 'Section'|t('portfolio') }}</th>
                        <th scope="col">{{ 'Fields'|t('portfolio') }}</th>
                        <th scope="col">{{ 'Templates'|t('portfolio') }}</th>
                        <th scope="col">{{ 'Status'|t('portfolio') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for portfolio in portfolios %}
                        {% set section = portfolio.getSection() %}
                        {% set problems = drift[portfolio.uid] ?? [] %}
                        <tr>
                            <th scope="row" data-title="{{ 'Name'|t('portfolio') }}">
                                <a href="{{ cpUrl('portfolio/' ~ portfolio.uid) }}">{{ portfolio.name }}</a>
                                {% if portfolio.adopted %}
                                    <span class="light">({{ 'adopted'|t('portfolio') }})</span>
                                {% endif %}
                            </th>
                            <td data-title="{{ 'Handle'|t('portfolio') }}"><code>{{ portfolio.handle }}</code></td>
                            <td data-title="{{ 'Section'|t('portfolio') }}">
                                {% if section %}
                                    <a href="{{ cpUrl('settings/sections/' ~ section.id) }}">{{ section.name }}</a>
                                {% else %}
                                    <span class="error">{{ 'Missing'|t('portfolio') }}</span>
                                {% endif %}
                            </td>
                            <td data-title="{{ 'Fields'|t('portfolio') }}">
                                {{ '{live} of {total}'|t('portfolio', {
                                    live: portfolio.liveRoles()|length,
                                    total: portfolio.roles|length,
                                }) }}
                            </td>
                            <td data-title="{{ 'Templates'|t('portfolio') }}"><code>{{ portfolio.templateRoot }}/</code></td>
                            <td data-title="{{ 'Status'|t('portfolio') }}">
                                {% if problems is empty %}
                                    <span class="status on" aria-hidden="true"></span>{{ 'In sync'|t('portfolio') }}
                                {% else %}
                                    <span class="status red" aria-hidden="true"></span>
                                    <span class="error">{{ '{n, plural, =1{# problem} other{# problems}}'|t('portfolio', { n: problems|length }) }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
