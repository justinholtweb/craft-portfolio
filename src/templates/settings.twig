{# =========================================================================
   Portfolio: plugin settings
   Rendered inside Craft's own plugin settings screen, which supplies the
   form, the namespace and the read-only notice when admin changes are off.
   ========================================================================= #}
{% import '_includes/forms' as forms %}

{% set readOnly = not craft.app.config.general.allowAdminChanges %}
{% set isPro = plugin.isPro() %}

{% set portfolioOptions = [{ value: '', label: 'The first one'|t('portfolio') }] %}
{% for portfolio in portfolios %}
    {% set portfolioOptions = portfolioOptions|push({ value: portfolio.handle, label: portfolio.name }) %}
{% endfor %}

{{ forms.selectField({
    label: 'Default portfolio'|t('portfolio'),
    instructions: 'Which portfolio `craft.portfolio.items()` means when a template does not name one. Templates can always be explicit with `craft.portfolio.of(\'handle\')`.'|t('portfolio'),
    id: 'defaultPortfolio',
    name: 'defaultPortfolio',
    options: portfolioOptions,
    value: settings.defaultPortfolio,
    errors: settings.getErrors('defaultPortfolio'),
    disabled: readOnly,
    first: true,
}) }}

<hr>

<h2>{{ 'Tag archives'|t('portfolio') }}</h2>

{{ forms.lightswitchField({
    label: 'Serve tag archives'|t('portfolio'),
    instructions: 'Craft tags have no URI of their own, unlike categories, so a tag archive needs a route. With this on, every portfolio that has a tag group serves `<template folder>/tag/<slug>`.'|t('portfolio'),
    id: 'tagArchives',
    name: 'tagArchives',
    on: settings.tagArchives,
    toggle: 'portfolio-tag-template',
    disabled: readOnly,
}) }}

<div id="portfolio-tag-template"{% if not settings.tagArchives %} class="hidden"{% endif %}>
    {{ forms.textField({
        label: 'Tag archive template'|t('portfolio'),
        instructions: 'Relative to each portfolio’s template folder.'|t('portfolio'),
        id: 'tagTemplate',
        name: 'tagTemplate',
        value: settings.tagTemplate,
        class: 'code',
        errors: settings.getErrors('tagTemplate'),
        disabled: readOnly,
    }) }}
</div>

<hr>

<h2>{{ 'The grid'|t('portfolio') }}</h2>

{% if not isPro %}
    <div class="readable">
        <blockquote class="note">
            <p>{{ '`craft.portfolio.grid()` and structured data are Pro features. Everything else (the content model, the starter templates and the whole query API) is in Lite.'|t('portfolio')|md(inlineOnly=true) }}</p>
        </blockquote>
    </div>
{% endif %}

<p class="light">
    {{ 'Defaults for `craft.portfolio.grid()`. Any of them can be overridden per call.'|t('portfolio')|md(inlineOnly=true) }}
</p>

{{ forms.selectField({
    label: 'Layout'|t('portfolio'),
    id: 'gridLayout',
    name: 'gridLayout',
    options: [
        { value: 'grid', label: 'Grid: even rows'|t('portfolio') },
        { value: 'masonry', label: 'Masonry: CSS columns'|t('portfolio') },
        { value: 'list', label: 'List: image beside text'|t('portfolio') },
    ],
    value: settings.gridLayout,
    errors: settings.getErrors('gridLayout'),
    disabled: readOnly,
}) }}

{{ forms.textField({
    label: 'Columns'|t('portfolio'),
    instructions: 'From 1 to 6.'|t('portfolio'),
    id: 'gridColumns',
    name: 'gridColumns',
    value: settings.gridColumns,
    type: 'number',
    min: 1,
    max: 6,
    size: 4,
    errors: settings.getErrors('gridColumns'),
    disabled: readOnly,
}) }}

{{ forms.textField({
    label: 'Card image width'|t('portfolio'),
    instructions: 'Pixels, from 100 to 4000. Cards are transformed to this width at a 4:3 crop.'|t('portfolio'),
    id: 'gridImageWidth',
    name: 'gridImageWidth',
    value: settings.gridImageWidth,
    type: 'number',
    min: 100,
    max: 4000,
    size: 6,
    errors: settings.getErrors('gridImageWidth'),
    disabled: readOnly,
}) }}

{{ forms.lightswitchField({
    label: 'Filtering on by default'|t('portfolio'),
    instructions: 'Renders a category filter bar and hides non-matching cards in the browser, so an archive page stays one cacheable response.'|t('portfolio'),
    id: 'gridFilterable',
    name: 'gridFilterable',
    on: settings.gridFilterable,
    disabled: readOnly,
}) }}

{{ forms.lightswitchField({
    label: 'Lightbox on by default'|t('portfolio'),
    instructions: 'A keyboard-accessible lightbox over each item’s images.'|t('portfolio'),
    id: 'gridLightbox',
    name: 'gridLightbox',
    on: settings.gridLightbox,
    disabled: readOnly,
}) }}

{{ forms.lightswitchField({
    label: 'Inline the grid CSS and JS'|t('portfolio'),
    instructions: 'Turn this off if you would rather copy the styles into your own stylesheet. The markup and class names are identical either way.'|t('portfolio'),
    id: 'gridAssets',
    name: 'gridAssets',
    on: settings.gridAssets,
    disabled: readOnly,
}) }}

<hr>

<h2>{{ 'Structured data'|t('portfolio') }}</h2>

{{ forms.lightswitchField({
    label: 'Emit schema.org CreativeWork'|t('portfolio'),
    instructions: 'Turns on `{{ craft.portfolio.jsonld(entry) }}`, which the starter item template already calls. Nothing is injected into pages; the tag decides where it goes.'|t('portfolio'),
    id: 'jsonLd',
    name: 'jsonLd',
    on: settings.jsonLd,
    disabled: readOnly or not isPro,
    warning: not isPro ? 'Requires Portfolio Pro.'|t('portfolio'),
}) }}
