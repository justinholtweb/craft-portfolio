{# =========================================================================
   Portfolio: adopt a section (Pro)
   Creates nothing: maps each role onto a field the section already has.
   `portfolio` is the unsaved model after a failed post, so values and
   validation errors survive the round trip.
   ========================================================================= #}
{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = 'Adopt a section'|t('portfolio') %}
{% set selectedSubnavItem = 'portfolios' %}
{% set fullPageForm = sections is not empty %}
{% set submitButtonLabel = 'Adopt'|t('portfolio') %}
{% set crumbs = [{ label: 'Portfolios'|t('portfolio'), url: cpUrl('portfolio') }] %}

{% set portfolio = portfolio ?? null %}

{% block content %}
    {% if sections is empty %}
        <div class="zilch">
            <p>{{ 'Every section on this site is either already a portfolio or a Single. There is nothing left to adopt.'|t('portfolio') }}</p>
        </div>
    {% else %}
        {{ actionInput('portfolio/portfolios/adopt') }}

        <p class="light">
            {{ 'Adopting creates nothing. You point each role at a field the section already has, and the portfolio becomes a map over your existing content model: the query API, the archives and the grid all start working against it.'|t('portfolio') }}
        </p>

        {% set sectionOptions = [] %}
        {% set entryTypeOptions = [] %}
        {% for section in sections %}
            {% set sectionOptions = sectionOptions|push({ value: section.uid, label: section.name ~ ' (' ~ section.handle ~ ')' }) %}
            {% set entryTypeOptions = entryTypeOptions|push({ optgroup: section.name }) %}
            {% for entryType in section.getEntryTypes() %}
                {% set entryTypeOptions = entryTypeOptions|push({ value: entryType.uid, label: entryType.name ~ ' (' ~ entryType.handle ~ ')' }) %}
            {% endfor %}
        {% endfor %}

        {{ forms.selectField({
            label: 'Section'|t('portfolio'),
            id: 'sectionUid',
            name: 'sectionUid',
            options: sectionOptions,
            value: portfolio.sectionUid ?? null,
            required: true,
            first: true,
            errors: portfolio ? portfolio.getErrors('sectionUid') : [],
        }) }}

        {{ forms.selectField({
            label: 'Entry type'|t('portfolio'),
            instructions: 'Which entry type in that section holds portfolio items. One from another section falls back to the chosen section’s first entry type.'|t('portfolio'),
            id: 'entryTypeUid',
            name: 'entryTypeUid',
            options: entryTypeOptions,
            value: portfolio.entryTypeUid ?? null,
            errors: portfolio ? portfolio.getErrors('entryTypeUid') : [],
        }) }}

        {{ forms.textField({
            label: 'Name'|t('portfolio'),
            instructions: 'Leave blank to use the section’s name.'|t('portfolio'),
            id: 'name',
            name: 'name',
            value: portfolio.name ?? null,
            errors: portfolio ? portfolio.getErrors('name') : [],
        }) }}

        {{ forms.textField({
            label: 'Handle'|t('portfolio'),
            instructions: 'What templates call this portfolio in `craft.portfolio.of(…)`. Leave blank to use the section’s handle.'|t('portfolio'),
            id: 'handle',
            name: 'handle',
            value: portfolio.handle ?? null,
            class: 'code',
            errors: portfolio ? portfolio.getErrors('handle') : [],
        }) }}

        {{ forms.textField({
            label: 'Template folder'|t('portfolio'),
            instructions: 'A path inside the templates folder, like `work` or `work/projects`. Leave blank to use the section’s handle.'|t('portfolio'),
            id: 'templateRoot',
            name: 'templateRoot',
            value: portfolio.templateRoot ?? null,
            class: 'code',
            errors: portfolio ? portfolio.getErrors('templateRoot') : [],
        }) }}

        <hr>

        <h2>{{ 'Roles'|t('portfolio') }}</h2>
        <p class="light">{{ 'Leave a role empty if this section has nothing that plays it. Templates and the grid skip roles that are not mapped.'|t('portfolio') }}</p>

        {% set fieldOptions = [{ value: '', label: 'None'|t('portfolio') }] %}
        {% for field in fields %}
            {% set fieldOptions = fieldOptions|push({ value: field.uid, label: field.name ~ ' (' ~ field.handle ~ ')' }) %}
        {% endfor %}

        {% for role in roles %}
            {{ forms.selectField({
                label: roleLabels[role] ?? role,
                instructions: roleDescriptions[role] ?? '',
                id: 'role-' ~ role,
                name: 'roles[' ~ role ~ ']',
                options: fieldOptions,
                value: portfolio.roles[role] ?? '',
            }) }}
        {% endfor %}
    {% endif %}
{% endblock %}
