{
    "name": "justinholtweb/craft-portfolio",
    "description": "Portfolio sections for Craft CMS — builds the section, entry type, fields and taxonomy in one go, then gives the front end a query API, starter templates and a drop-in grid.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "portfolio",
        "projects",
        "case-studies",
        "gallery",
        "showcase",
        "scaffolding"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-portfolio",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-portfolio/docs",
        "source": "https://github.com/justinholtweb/craft-portfolio",
        "issues": "https://github.com/justinholtweb/craft-portfolio/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^1.12 || ^2.2"
    },
    "suggest": {
        "craftcms/ckeditor": "Portfolio will use a CKEditor field for the project description when this is installed."
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\portfolio\\": "src/"
        }
    },
    "scripts": {
        "phpstan": "phpstan --memory-limit=1G",
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Portfolio",
        "handle": "portfolio",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-portfolio/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-portfolio/main/CHANGELOG.md",
        "class": "justinholtweb\\portfolio\\Plugin"
    }
}
